# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# The following `prisma+postgres` URL is similar to the URL produced by running a local Prisma Postgres 
# server with the `prisma dev` CLI command, when not choosing any non-default ports or settings. The API key, unlike the 
# one found in a remote Prisma Postgres URL, does not contain any sensitive information.
DB_USER=postgres
DB_PASSWORD=postgres

AUTH_DB_NAME=auth-db
USER_DB_NAME=user-db
FLEET_DB_NAME=fleet-db
PAYMENT_DB_NAME=payment-db
RENTAL_DB_NAME=rental-db
TEMPORAL_DB_NAME=temporal-db
MEMBERSHIP_DB_NAME=membership-db
INCIDENT_DB_NAME=incident-db

ADMIN_EMAIL=example_email@example.com
ADMIN_PASSWORD=examlpe_password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=example_password_redis

DOMAIN= replace with your domain
FRONTEND_URL=http://localhost:3000

JWT_ACCESS_EXPIRATION_TIME=15m
JWT_REFRESH_EXPIRATION_TIME=7d
JWT_ACCESS_SECRET=secret
JWT_REFRESH_SECRET=secret

CF_API_EMAIL=phantryong@gmail.com
CLOUDFLARE_DNS_API_TOKEN=
TRAEFIK_DASHBOARD_USERS=

COMPOSE_BAKE=true
COMPOSE_CONVERT_WINDOWS_PATHS=1

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=onboarding@resend.dev

VNPAY_TMN_CODE =
VNPAY_HASHSECRET =
