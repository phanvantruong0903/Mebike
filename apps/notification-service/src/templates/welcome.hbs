<body style="margin: 0; padding: 0; background-color: #f2f2f5; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #1f1f1f;">

  <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
    <tr>
      <td align="center" style="padding: 40px 0;">
        
        <table border="0" cellpadding="0" cellspacing="0" width="500" style="background-color: #ffffff; border-radius: 12px; border: 1px solid #e5e5e5; overflow: hidden; max-width: 500px; width: 100%;">
          
          <tr>
            <td bgcolor="#4CAF50" style="height: 6px; font-size: 0; line-height: 0;">&nbsp;</td>
