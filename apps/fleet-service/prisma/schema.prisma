generator client {
  provider = "prisma-client-js"
  output = "../../../common/src/lib/prisma/fleet/generated"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Supplier {
  id            String           @id @default(uuid())
  name          String
  contactInfo   Json 
  contactFee   Decimal          @db.Decimal(8,4)
  status        SupplierStatus   @default(Active)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("suppliers")
}

enum SupplierStatus {
  Active
  Inactive
}