generator client {
  provider = "prisma-client-js"
  output = "../../../common/src/lib/prisma/membership/generated"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Subscription {
  id                    String       @id @default(uuid())
  accountId                String
  packageId             String?
  activatedAt           DateTime?
  expiredAt             DateTime?
  usageCounts           Int          @default(0)
  status                SubscriptionStatus   @default(Pending)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@map("subscriptions")
}

model Package {
  id                    String       @id @default(uuid())
  name                  String       @unique
  price                 Decimal     
  maxUsages             Int?
  usageType             UsageType      @default(Finite)
  status                PackageStatus   @default(Active)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@map("packages")
}

enum UsageType {
  Finite
  Infinite
}

enum PackageStatus {
  Active
  Inactive
}

enum SubscriptionStatus {
  Pending
  Active
  Cancelled
  Expired
}
