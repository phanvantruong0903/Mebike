generator client {
  provider = "prisma-client-js"
  output = "../../../common/src/lib/prisma/rental/generated"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Rental {
  id             String       @id @default(uuid())
  userId         String
  bikeId         String?
  startStation   String
  endStation     String?
  startTime      DateTime     @default(now())
  endTime        DateTime?
  duration       Int          @default(0)
  totalPrice     Decimal      @default(0)
  subscriptionId String?
  status         RentalStatus @default(Rented)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("rentals")
}

model Reservation {
  id                    String       @id @default(uuid())
  userId                String
  bikeId                String?
  stationId            String
  startTime             DateTime     @default(now())
  endTime               DateTime?
  prepaid               Decimal      @default(0)
  subscriptionId        String?
  status                ReservationStatus   @default(Pending)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@map("reservations")
}

model Subscription {
  id                    String       @id @default(uuid())
  userId                String
  packageId             String?
  activatedAt           DateTime?
  expiresAt             DateTime?
  usageCounts           Int          @default(0)
  status                SubscriptionStatus   @default(Pending)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@map("subscriptions")
}

model Package {
  id                    String       @id @default(uuid())
  name                  String       @unique
  price                 Decimal     
  maxUsages             Int?           
  status                PackageStatus   @default(Active)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@map("packages")
}

enum PackageStatus {
  Active
  Inactive
}

enum SubscriptionStatus {
  Pending
  Active
  Cancelled
  Expired
}

enum ReservationStatus {
  Pending
  Active
  Cancelled
  Expired
}

enum RentalStatus {
  Rented
  Completed
  Cancelled
  Reserved
}
